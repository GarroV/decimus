# Секреты
.env
.env.*
!.env.example

# Чувствительное: методика УК и боевые проверки партнёров.
# Файлы остаются локально как референс и эталон регресса, но в публичный репозиторий не уходят.
#
# Здесь ЧЕТЫРЕ правила, и каждое закрывает то, что не закрывает соседнее.
# Обе пары нужны целиком — проверено запуском на изолированном репозитории,
# регресс лежит в tests/test_gitignore_data.py:
#
#   /data/  — ведущая косая обязательна. Без неё `data/` совпадает с ЛЮБЫМ
#             каталогом `data` на любой глубине: так молча пропал весь
#             синтетический набор `demo/data/` (T074) — файлы лежали на диске
#             у автора, в индекс не попали ни одним коммитом, и приёмка этого
#             не увидела.
#   /data   — без ХВОСТОВОЙ косой. Правило со слэшем на конце совпадает только
#             с настоящим каталогом и НЕ совпадает с символической ссылкой:
#             `git add data` на подложенном симлинке проходит успешно и уносит
#             в публичный репозиторий абсолютный путь с машины автора. А в
#             рабочие копии блоков данные подкладываются в том числе симлинком.
/data
/data/
/examples
/examples/

# Питон
__pycache__/
*.pyc
.venv/
venv/

# Состояние проверок
inspection.json
checklist_data/
secret.env
.venv

# Артефакты прогона
.coverage
# Файлы данных покрытия подпроцессов движка (make cov-engine, T037)
.coverage.*
reports/

# Артефакты установки пакета
*.egg-info/

# Демо-состояние: результат идемпотентного сида, в git не хранится
demo/state/

# Архивы состояния (`make state-backup`, задача #233). Внутри — папки идущих
# проверок партнёров и связки доступа. Репозиторий ПУБЛИЧНЫЙ, и умолчание
# BACKUP_DIR указывает сюда же, рядом с кодом: без этой строки один `git add`
# с размаху выкладывает историю проверок наружу навсегда.
backups/

# Мусор macOS: Finder кладёт его в любую открытую папку. В раскатке дизайна
# (forma tools/spread.py) он делал дерево «грязным», и копии не доезжали.
.DS_Store
