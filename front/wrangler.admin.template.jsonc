// ШАБЛОН конфига фронта веб-админки: https://decimus.vasiliy-garro.workers.dev
// Адреса инфраструктуры в репозиторий не кладутся (D431): рабочий
// `wrangler.admin.jsonc` собирает `./deploy.sh` из этого шаблона и
// неотслеживаемого `front/.deploy.env`. Руками выкладывать шаблон нельзя.
// Ключ фронта — секретом: `npx wrangler secret put FRONT_KEY -c wrangler.admin.jsonc`.
{
  "name": "decimus",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Журналы Worker'а выключены: через него идут пароли, ключи и тела форм.
  "observability": { "enabled": false },
  // Туннель к Caddy на VPS (Workers VPC, D304): сервис vps-edge-caddy.
  "vpc_services": [{ "binding": "EDGE", "service_id": "<VPC_SERVICE_ID>" }],
  "vars": { "ORIGIN_HOST": "<ORIGIN_HOST>", "STATIC_CACHE": "1" },
  // Кэш Worker'а только у точки входа статики (#698): подзапрос через EDGE мимо кэша
  // Cloudflare, и каждый файл шёл до VPS. Страницы под логином остаются без кэша.
  // Нужен Wrangler 4.107.0+. Проверка после выкладки — docs/08-deploy.md, §8.9.
  "cache": { "enabled": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "StaticCache": { "type": "worker", "cache": { "enabled": true } }
  }
}
