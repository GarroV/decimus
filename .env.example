# Пример конфигурации. Скопировать в .env и заполнить значения.
# Настоящий .env в git не попадает.

# Токен бота от @BotFather. У каждого продукта свой: Telegram отдаёт
# обновления только одному получателю, второй молча выбивает первого.
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI: разбор комментариев и транскрипция голосовых.
OPENAI_API_KEY=

# Каталог с методикой: чек-лист, зоны, критерии, ставки вычетов.
# Держится вне репозитория — это данные управляющей компании.
AUDIT_DATA_DIR=./data

# Где лежат файлы состояния проверок (папка на чат). Здесь же продукт держит
# снимки изданий методики (`methodology/<издание>/`, задача T169): проверка
# идёт по тому изданию, при котором её начали, и переиздание методики посреди
# выезда её не задевает. Каталог обязан быть на записи и обязан переживать
# перезапуск: потерянный снимок возвращает проверку к отказу на подсчёте.
STATE_DIR=./.state

# --- демо-стенд (профиль `demo` в docker-compose.yml, задача T102) -----------
#
# Демо настраивается ТЕМ ЖЕ механизмом и из ТОГО ЖЕ файла, что боевой стенд
# (решение D059) — отдельного набора переменных где-то ещё нет. Ниже только
# то, что обязано отличаться; всё остальное (OPENAI_API_KEY, TZ, RECOGNIZE_*,
# AUDITOR_NAMES) демо берёт отсюда же, без дублей.

# Где лежит состояние демо. `make demo` и сид пишут сюда, а НЕ в STATE_DIR:
# на сервере STATE_DIR указывает на настоящие проверки, и демо-отчёт лёг бы в
# одну папку с отчётами партнёрам. Пусто — demo/state в репозитории.
# Демо-стенд в контейнере ставит сюда свой том.
DEMO_STATE_DIR=

# Токен ВТОРОГО бота от @BotFather — для демо. Один токен на два бота не
# делится: Telegram отдаёт обновления одному получателю, второй молча выбивает
# первого. Пусто — демо-бот откажется стартовать; это лучше, чем демо,
# случайно поднятое на боевом токене.
DEMO_TELEGRAM_BOT_TOKEN=

# Кому разрешён демо-бот. Telegram ID через запятую, свой список — тем, кому
# показываем; боевой список сюда не копируется.
DEMO_ALLOWED_TELEGRAM_IDS=

# База демо. Пусто — демо не пишет в базу вовсе. Боевую строку подключения
# сюда не ставить ни при каких обстоятельствах: демо не трогает боевые данные.
DEMO_DATABASE_URL=

# Кому разрешено пользоваться ботом. Telegram ID через запятую.
ALLOWED_TELEGRAM_IDS=

# Кого ждём по ЮЗЕРНЕЙМУ, пока его числовой ID неизвестен (задача #230):
# «username:Имя Фамилия» через запятую, `@` и регистр не важны, имя
# необязательно. Пример: BOT_INVITES=apetrov:Anna Petrova,@Ivanov
#
# Зачем это вообще: числа нового аудитора неоткуда взять заранее. Bot API не
# отдаёт ID по юзернейму, а сам ID приходит только в апдейте — то есть уже
# после того, как человек написал. Приглашённый пишет боту что угодно
# (обычно `/start`), бот берёт ID из этого апдейта, записывает связку в
# STATE_DIR/access/roster.json и дальше пускает уже по числу.
#
# ПРИГЛАШЕНИЕ СРАБАТЫВАЕТ ОДИН РАЗ. Юзернейм владелец отпускает в любой
# момент, и освободившийся занимает кто угодно другой; постоянным ключом
# остаётся ID. Убрать человека — убрать его ID из ALLOWED_TELEGRAM_IDS и его
# запись из roster.json, правки одного лишь этого списка мало.
#
# Имя отсюда уходит в шапку отчёта партнёру, поэтому AUDITOR_NAMES для
# приглашённых заполнять не нужно — она нужна, только чтобы имя ПОПРАВИТЬ.
BOT_INVITES=

# Имя проверяющего для шапки отчёта по его Telegram ID: «ID:Имя Фамилия» через
# запятую. Необязательна — без неё имя берётся из профиля Telegram.
AUDITOR_NAMES=

# Куда сливаются завершённые проверки (D027). Строка подключения Postgres
# целиком — площадка вынесена в неё саму и больше никуда: переезд в Supabase
# позже будет стоить правки этой одной строки, без единой правки кода (D061).
# Пример для своего Postgres на машине: postgresql://user@127.0.0.1:5432/dodo_audit_service
# Пример для базы из профиля `db` ниже, с хоста: postgresql://dodo_audit:ПАРОЛЬ@127.0.0.1:5432/dodo_audit_service
# Она же изнутри контейнера бота: postgresql://dodo_audit:ПАРОЛЬ@db:5432/dodo_audit_service
DATABASE_URL=

# Роль, под которой ходит приложение, и роль, под которой катятся миграции —
# РАЗНЫЕ, и это не аккуратность (задача T111). Запрет правки завершённой
# проверки держится построчными политиками, а суперпользователь Postgres
# обходит их ВСЕГДА. Приложение под привилегированной ролью выглядело бы
# защищённым, ничем таковым не являясь; раннер миграций предупреждает об этом
# вслух при накате.
#
# DATABASE_ADMIN_URL — подключение с правом заводить роли и накатывать схему.
# Пусто — миграции идут под DATABASE_URL, и предупреждение вы увидите.
DATABASE_ADMIN_URL=
# DATABASE_APP_PASSWORD — пароль роли приложения `dodo_audit_app`. Задать при
# первом накате; пустая строка отвергается отказом, потому что пустой пароль
# оставил бы роль без входа молча. Убрать переменную совсем — пароль не
# трогается.
DATABASE_APP_PASSWORD=

# Третья роль — АДМИНИСТРАТОР ИСТОРИИ, `dodo_audit_admin` (задача T210).
# Снятая проверка остаётся в истории пометкой (D086, D089), но обычной роли
# приложения не видна вовсе: её прячет построчная политика, а не фильтр в
# запросе. Видит и снимает только эта роль — и приходит она отдельным
# подключением.
#
# НЕ ПУТАТЬ с DATABASE_ADMIN_URL выше: та про НАКАТ СХЕМЫ и обычно
# привилегированная, а привилегированная роль обходит политики всегда —
# подставленная сюда, она отдала бы «администраторский» ответ кому угодно.
#
# ЭТОЙ ЖЕ РОЛЬЮ ПРАВИТСЯ КАРТА СИНОНИМОВ ФОРМУЛИРОВОК (задача T292, миграция
# 0013): снять неверно выученный синоним и переправить его на другой пункт
# может только она. Роль приложения карту по-прежнему только пополняет —
# переписывать выученное ошибкой одного аудитора нечем.
#
# Пусто — снятие и чтение снятых проверок, а также правка карты синонимов
# отказывают явно (это законная настройка стенда, на котором править некому).
# Пример: та же строка, что DATABASE_URL, но с пользователем dodo_audit_admin.
DATABASE_RETRACTION_URL=
# DATABASE_RETRACTION_PASSWORD — пароль роли `dodo_audit_admin`. Ставится
# накатом так же, как пароль роли приложения, и по тем же правилам. Отдельный
# от него намеренно: одинаковый пароль у двух ролей означал бы, что
# разграничение держится тем, кто какую строку подключения взял.
DATABASE_RETRACTION_PASSWORD=

# --- Postgres рядом с ботом (профиль `db` в docker-compose.yml, задача T090) -
#
# Нужны только тому, кто поднимает базу этим же compose (`make db-up`). Если
# DATABASE_URL выше указывает на уже существующий Postgres, профиль `db` не
# поднимается и переменные ниже не читаются вовсе.

# Имя базы и роль внутри контейнера. DATABASE_URL обязан совпадать с ними.
POSTGRES_DB=dodo_audit_service
POSTGRES_USER=dodo_audit

# Пароль роли. Пусто — контейнер откажется стартовать с внятным сообщением;
# это лучше, чем база проверок партнёров, поднятая без пароля.
POSTGRES_PASSWORD=

# Порт базы на хосте. Наружу он не смотрит — только на петлю (127.0.0.1), см.
# docker-compose.yml. Менять здесь приходится в двух случаях: на машине уже
# занят 5432 своим Postgres, и параллельные рабочие копии обязаны расходиться
# по портам. Изменил порт — поменяй и DATABASE_URL выше.
POSTGRES_PORT=5432

# --- MCP-сервер поверх базы проверок (задача T095, решение D055) -------------
#
# Сервер даёт спрашивать накопленные проверки через Claude. Проверки — только
# на чтение: записать проверку через него нельзя ничем. Правка методики
# (чек-листа) — отдельная настройка ниже, и по умолчанию она выключена.
#
# КТО СПРАШИВАЕТ, ТОТ И ОПРЕДЕЛЯЕТ, ЧЬИ ПРОВЕРКИ ВИДНЫ. Код арендатора берётся
# из токена и ниоткуда больше: аргументом вызова его назвал бы кто угодно, и
# агент партнёра прочитал бы историю соседа. Формат — «арендатор=токен» через
# запятую или с новой строки; у одного арендатора может быть несколько токенов
# (по человеку на токен), один токен на двух арендаторов — отказ на старте.
#
# Токен генерируется случайным и длинным, например:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Пусто — законно, если задана DATABASE_URL: тогда ходят по личным токенам,
# которые выпускает бот пунктом «Установка MCP» (T253). Сервер откажется
# подниматься, только когда пусты ОБЕ двери: открытый сервер хуже
# не поднявшегося.
MCP_TOKENS=

# Адрес и порт, на которых слушает сервер. Только петля: площадка общая, и
# порт, открытый в сеть, отдал бы проверки партнёров соседям по машине —
# адрес вне петли сервер не примет. Пусто — 127.0.0.1 и 8265.
#
# На стенде из docker-compose.yml MCP_HOST сюда не смотрит вовсе: адрес
# сервису задаёт само описание стенда (127.0.0.1 — петля КОНТЕЙНЕРА mcp), и
# значение отсюда в контейнер не попадает. MCP_PORT — наоборот, контейнер
# берёт его из этого файла. Меняя порт, меняйте вместе с ним и адрес, на
# который смотрит туннель в панели Cloudflare (см. раздел про
# CLOUDFLARE_TUNNEL_TOKEN ниже) — иначе туннель останется смотреть на старый
# порт и будет отвечать «за ним никого нет».
MCP_HOST=
MCP_PORT=

# --- доступ к MCP снаружи туннелем (задача T256, решение D100) ---------------
#
# Наружу выходим туннелем, а не открытым портом: сервер слушает петлю (см.
# MCP_HOST/MCP_PORT выше), площадка общая — рядом живут чужие проекты, — а
# сервер отдаёт проверки партнёров по токену. Открытый порт отдал бы их
# соседям по машине.

# Токен туннеля. Значение выдаёт панель Cloudflare при создании туннеля —
# здесь только ИМЯ переменной, само значение живёт в .env и в git не попадает
# никогда.
#
# Пусто — cloudflared откажется стартовать со словами «Provided Tunnel token
# is not valid» (проверено запуском); это лучше, чем туннель, поднятый
# неизвестно куда.
#
# Туннель настраивается на стороне Cloudflare на адрес http://127.0.0.1:8265
# — то есть на петлю контейнера mcp, в сетевом пространстве которого туннель
# и живёт (docker-compose.yml, сервис tunnel). Поменяли MCP_PORT — поменяйте
# и адрес в панели Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=

# Переменная самого docker compose, а не продукта: перечисленные здесь
# профили включаются при обычном `docker compose up -d`. Что ставить, зависит
# от того, чем площадка выходит наружу:
#   funnel — общий вход площадки (Tailscale Funnel). Поднимается звено `link`:
#            сервер слушает петлю ВНУТРИ контейнера, и без звена проброшенный
#            порт до него не доходит (#216).
#   tunnel — свой домен и свой туннель Cloudflare (нужен CLOUDFLARE_TUNNEL_TOKEN).
# Пусто на площадке — стенд выглядит здоровым, а снаружи доступа нет. Забытая
# строка ловится смоуком раскатки scripts/smoke.sh, а не тишиной.
#
# На ноутбуке разработчика переменная не нужна: наружу там выходить незачем.
COMPOSE_PROFILES=

# --- снятие проверки из истории (задача T211, решения D086 и D089) -----------
#
# Неверный отчёт не правится: заводится новый, а старый СНИМАЕТСЯ — и снимается
# через MCP, не в боте. Снятие необратимо для партнёра: отчёт и письмо у него
# на руках, а кадры проверки уезжают из хранилища насовсем. Строка истории при
# этом остаётся — помеченной и с причиной, — но из обычного чтения проверка
# пропадает целиком.
#
# ЗДЕСЬ ПЕРЕЧИСЛЯЮТСЯ САМИ ТОКЕНЫ, А НЕ АРЕНДАТОРЫ, и это не небрежность.
# Арендатор у снятия уже назван предъявленным токеном: снимается проверка его и
# только его. Открытым остаётся другой вопрос — кто именно из людей, а токенов
# у арендатора несколько, по человеку на токен (см. MCP_TOKENS выше). Право,
# выданное стороне, досталось бы и тому токену, который отдали агенту на
# чтение.
#
# Токен пишется тот же самый, что слева стоит в MCP_TOKENS. Разойтись копии
# молча не могут: токен, названный здесь и отсутствующий в MCP_TOKENS, — отказ
# на старте, то есть смена токена в одном месте и забытая в другом роняет
# сервер, а не отбирает право тихо. Пусто — снятие закрыто всем, и это
# значение по умолчанию.
#
# Второй половиной снятия работает DATABASE_RETRACTION_URL (см. выше): снятые
# проверки видит только роль dodo_audit_admin, и приходит она отдельным
# подключением. Не задана — инструмент отказывает и называет переменную.
MCP_RETRACTION_TOKENS=

# --- правка методики через агента (задача T098, решения D049 и D050) ---------
#
# ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ MCP ПЕРЕСТАЁТ БЫТЬ ТОЛЬКО ЧТЕНИЕМ. За этими
# двумя переменными — правка методики управляющей компании, той самой, по
# которой считаются отчёты партнёрам. Обе пустые — инструменты методики
# выключены целиком, и сервер отвечает только на вопросы о проверках.
#
# Правка не переписывает действующий набор. Каждая правка кладёт РЯДОМ новую
# версию, движок её проверяет, и только принятую им версию можно опубликовать
# отдельным вызовом. Старые версии не удаляются никогда: по ним посчитаны
# отчёты, и отчёт годичной давности обязан оставаться объяснимым (D050).

# Каталог хранилища версий. Внутри: versions/<версия> — снимки методики,
# current — указатель на действующую, journal.jsonl — журнал правок.
# Каталог не в git: методика — данные управляющей компании (D002).
#
# ЭТУ ЖЕ ПЕРЕМЕННУЮ ЧИТАЕТ ВЕБ-АДМИНКА (раздел «Методика», T320): состав
# чек-листа правится с экрана тем же хранилищем, что из разговора с агентом.
# Своей переменной у веба нет намеренно — второй путь к одной методике
# разошёлся бы с первым, и правка с экрана уехала бы мимо той методики, по
# которой считает движок. Не задана — раздел открывается и называет, чего не
# хватает, а состава не показывает вовсе.
MCP_CHECKLIST_STORE=

# Кому открыта ПРАВКА методики — и вместе с ней чтение версий, карты слов и
# карты синонимов. Коды арендаторов через запятую или с новой строки, ровно те
# же, что слева от «=» в MCP_TOKENS. Методика одна на всю сеть, и правит её
# управляющая компания: токен партнёра открывает его проверки, но не её.
#
# ИСХОДНИК ЭТАЛОНА этой переменной не подчиняется (T315, D132): чек-лист,
# по которому идут проверки, читает всякий заведённый токен — инструментами
# checklist_source и checklist_source_item, — потому что проверяемая сторона
# обязана видеть, по чему её проверяют. Правки в тех двух нет вовсе. Названный здесь арендатор,
# которого нет среди токенов, — отказ на старте: опечатка иначе выглядела бы
# работающей настройкой.
MCP_CHECKLIST_TENANTS=

# Боевая методика берётся из AUDIT_DATA_DIR — того же каталога, из которого
# читает движок. Своей переменной у сервера нет намеренно: второй путь к одной
# методике разошёлся бы с первым, и агент правил бы не то, по чему считается
# оценка. С этого каталога начинается хранилище версий.
#
# ЧТОБЫ ПУБЛИКАЦИЯ РАБОТАЛА, AUDIT_DATA_DIR обязан указывать на сам указатель
# хранилища (MCP_CHECKLIST_STORE/current) — публикация переставляет его.
# Пока AUDIT_DATA_DIR смотрит в обычный каталог методики, версии заводятся и
# проверяются, а публикация получает отказ: молча «опубликовать» то, чего
# движок не увидит, хуже, чем не опубликовать вовсе.
#
# Порядок настройки, один раз:
#   1) AUDIT_DATA_DIR=/путь/к/data, MCP_CHECKLIST_STORE=/путь/к/checklist-store
#   2) любой вызов инструмента методики заводит хранилище снимком из data
#   3) переставить AUDIT_DATA_DIR на /путь/к/checklist-store/current

# --- хранилище кадров (задача T094, решения D004 и D054) ---------------------
#
# Идентификатор кадра в телеграме снаружи не открывается и живёт ровно столько,
# сколько живёт бот с этим токеном: в базе он мёртвая ссылка на доказательство.
# Поэтому при завершении проверки кадры уезжают в S3-совместимое хранилище.
# Имена переменных S3-совместимые и поставщика не называют: смена хранилища
# (Supabase Storage, AWS, что угодно ещё) — правка значений, не кода.

# Корзина, куда ложатся кадры. Продукт её не создаёт: в настоящем хранилище
# таких прав у него нет и быть не должно — корзина заводится заранее.
S3_BUCKET=inspection-frames

# Ключи доступа. В git не попадают никогда, только сюда, в .env.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Адрес хранилища. ПУСТО — это настоящий AWS S3, и только он: подставлять сюда
# что-то по умолчанию нельзя, иначе кадры уедут не туда, куда думал
# запускающий, и молча. Для локального стенда (профиль `storage`) —
# http://127.0.0.1:9090 с хоста или http://storage:9090 изнутри контейнера бота.
S3_ENDPOINT_URL=

# Регион. У S3-совместимых серверов формальность, но без него не собирается
# подпись запроса. Пусто — us-east-1.
S3_REGION=

# Порт локального стенда хранилища на хосте (профиль `storage`). Наружу не
# смотрит — только на петлю. Стенд нужен для смоука: тома у него нет, данные не
# переживают пересоздание контейнера. Боевое хранилище задаётся S3_* выше.
S3_STAND_PORT=9090

# Порты СВОЕГО боевого хранилища на площадке (профиль `storage-live`, D166):
# сам протокол и консоль администратора. Оба только на петлю — доказательства
# проверок на общем адресе делать нечего, наружу файлы выдаёт админка.
# Учётка хранилища берётся из S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY выше:
# они же служат ключами доступа продукта, второй пары не заводится.
S3_LIVE_PORT=9000
S3_CONSOLE_PORT=9001

# polling — разработка и работа без публичного адреса; webhook — когда адрес появится.
BOT_MODE=polling

# Язык, на котором бот говорит ДО начала проверки: приветствие и мастер начала
# (задача T131). Начатая проверка дальше говорит своим языком — тем, который
# аудитор выбрал в мастере, — и эту переменную уже не слушает.
#
# Пусто — русский, как боевой бот работает с первого дня. Известные значения:
# ru, en (третий добавляется строками в src/bot/texts.py, а не сюда).
# Неизвестное значение — отказ на старте: молча стать русским бот не имеет
# права, иначе опечатка обнаружится на показе заказчику.
#
# Демо-стенду эту переменную задавать не нужно: профиль `demo` в
# docker-compose.yml ставит себе `en` сам. Демо обязано быть английским
# целиком, и это свойство демо, а не настройка запускающего.
BOT_UI_LANG=

# Адрес MCP-сервера, который бот ПЕЧАТАЕТ в пункте меню «Установка MCP»
# (задача T209, решение D087). Не адрес, куда бот ходит: он туда не ходит.
#
# Сюда пишется АДРЕС ТУННЕЛЯ площадки (https://…), и ничего другого: бот
# раздаёт эту строку РАЗНЫМ людям на РАЗНЫЕ машины, а не одному человеку за
# своим компьютером. Адрес петли (http://127.0.0.1:…) здесь — дефект
# настройки стенда, а не «локальный вариант»: человек из другого города
# получит строку, указывающую на его собственную машину, и решит, что
# сломался Claude, а не стенд.
#
# Проверяется это не глазами, а прогоном tools/mcp_outside.py С ЧУЖОЙ
# машины — он намеренно отказывается считать петлю проверкой.
#
# Отдельно от MCP_HOST/MCP_PORT намеренно: сервер слушает петлю и наружу не
# публикуется (см. выше), а здесь стоит факт про то, куда ведёт туннель, —
# это другой факт, а не копия того, на чём сервер поднялся.
#
# Пусто — в команде на месте адреса стоит заглушка ЗАГЛАВНЫМИ, как и на месте
# токена: подставить петлю молча значило бы выдать догадку за настройку стенда.
#
# Токен в этой команде — раньше здесь всегда стояла заглушка: бот не знал,
# чей токен чей, а MCP_TOKENS выше связывает токен со СТОРОНОЙ, а не с
# человеком. С задачи T253 (решения D098, D099) бот выпускает токен на
# конкретного человека и печатает его настоящим — см. BOT_MCP_OWNER_ID и
# BOT_MCP_TENANT ниже. MCP_TOKENS при этом никуда не делся: это вторая,
# независимая дверь, и обе работают одновременно (`src/mcp/config.py:
# resolve_access`).
BOT_MCP_URL=

# --- личный доступ к MCP: круг и токены, выпускаемые ботом (задача T253,
#     решения D098, D099) ------------------------------------------------------
#
# ОСНОВАТЕЛЬ круга людей, которым доступна настройка подключения (`/mcp` и
# админка `/mcp_add`, `/mcp_revoke`, `/mcp_who`). Единственный человек,
# попадающий в круг настройкой стенда, а не приводом изнутри чата — остальных
# приводит тот, кто уже в круге, командой `/mcp_add`.
#
# Пусто — круг не назначен, и настройка подключения не доступна НИКОМУ: пустой
# круг закрыт, а не открыт. Умолчание «пускать всех» здесь было бы худшим из
# возможных — забытая переменная раздавала бы историю проверок партнёров
# всякому, кто спросит.
#
# ОСНОВАТЕЛЬ ОБЯЗАН ВХОДИТЬ В ALLOWED_TELEGRAM_IDS. Иначе мидлварь доступа не
# пустит его до команды никогда, и круг останется пустым навсегда, — а
# выглядела бы такая настройка работающей. Отказ на старте называет это прямо.
BOT_MCP_OWNER_ID=

# Чью историю проверок открывают токены, которые ВЫПУСКАЕТ этот бот. Не
# путать с MCP_TOKENS выше — там связка «токен → арендатор» задаётся вручную
# по стороне; здесь то же самое решается один раз настройкой стенда, а не
# разговором в чате.
#
# Пусто — тот же арендатор, под которым этот бот сливает проверки
# (`src.domain.state.DEFAULT_TENANT`). Это не догадка, а то же самое значение:
# функций мультиарендности в MVP нет (решение D005), и токен, открывающий
# что-то другое, не открывал бы ничего. Стенд, сменивший арендатора проверок,
# обязан сменить и эту переменную.
BOT_MCP_TENANT=

# Часовой пояс: в контейнере по умолчанию UTC, и даты в отчёте уедут.
TZ=Europe/Belgrade

# --- выгрузка состояния в бэкап (профиль `backup`, задача #233) --------------
#
# В томе состояния лежат папки идущих проверок и связки доступа
# (`access/roster.json`). Бэкап площадки умеет только дампы Postgres, поэтому
# состояние выгружается отдельно: `make state-backup` или
# `docker compose run --rm state-backup`, по расписанию — docs/08-deploy.md §4.7.

# Каталог бэкапа НА ХОСТЕ. На площадке это C:\backups — тот же каталог, куда
# кладёт дампы задача Postgres; он общий с чужими проектами машины, поэтому по
# сроку хранения удаляются только файлы вида decimus-state-*.tar.gz и ничьи
# больше. Пусто — архивы лягут в ./backups рядом с копией репозитория.
BACKUP_DIR=./backups

# Сколько суток хранить СВОИ архивы состояния. 14 — как у бэкапа Postgres на
# площадке, чтобы два разных срока не пришлось держать в голове. 0 означает
# «не удалять ничего»: место кончится молча, поэтому ставить осознанно.
BACKUP_KEEP_DAYS=14

# Ниже — настройки разбора (блок recognize). Все необязательны: без них
# берутся значения по умолчанию из src/recognize/config.py, здесь — те же
# значения, чтобы .env.example был честной шпаргалкой, а не пустыми именами.

# Модель разбора комментария и фото. Флагман — решение D013, цена ошибки
# (неверный отчёт партнёру) несопоставима с разницей в 93 цента на проверку.
RECOGNIZE_MODEL=gpt-5.6-sol

# Модель транскрипции голосовых (решение D008).
RECOGNIZE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Таймаут одного вызова модели, секунд.
RECOGNIZE_TIMEOUT=90

# Порог уверенности: ниже — кандидат показывается, но помечается «нужен человек».
RECOGNIZE_MIN_CONFIDENCE=0.6

# Максимум кандидатов кнопками: больше пяти аудитор на телефоне не разберёт.
RECOGNIZE_MAX_CANDIDATES=5

# Путь к бинарнику ffmpeg (перекодировка голосовых, решение D008). В образе
# `Dockerfile` ffmpeg стоит системно и виден по имени — оставить как есть.
FFMPEG_BIN=ffmpeg

# ═══ Веб-админка управляющей компании (T318, T319, T323; D148, D155) ═══════
#
# Поверхность, которую открывают глазами: реестр проведённых проверок, карточка
# проверки, снятие проверки из истории. Читает те же двери, что MCP
# (src/db/queries.py, src/db/retract.py), своих запросов к базе не пишет и
# оценку не пересчитывает.
#
# ВХОД ЕСТЬ (T323): ни одна страница не открывается без логина и пароля.
# Учётки заводит команда проекта — `make web-user ARGS="add <логин>
# --tenant <код>"`; регистрации снаружи нет. Сервер при этом по-прежнему
# слушает только петлю (адрес вне петли не примет вовсе), а наружу выходит
# туннелем, а не публикацией порта (D100). Посмотреть на хосте — `make web`.

# Чей стенд: код тенанта, чью историю показывает эта админка. ОБЯЗАТЕЛЬНА,
# значения по умолчанию нет намеренно: подстановка выглядела бы работающей
# ровно до второго тенанта, а потом показала бы историю одной страны
# сотрудникам другой (то же правило, что у src/db/queries.py).
WEB_TENANT=

# Адрес и порт. Пусто — 127.0.0.1 и 8267 (следующий свободный за MCP: 8265
# занимает сам сервер, 8266 — звено до него). Адрес вне петли — отказ на
# старте, а не предупреждение.
WEB_HOST=
WEB_PORT=

# Язык интерфейса админки: ru или en. Пусто — ru. Незаведённый язык — отказ на
# старте, а не молчаливый откат: опечатка иначе обнаружилась бы на показе.
# Это язык ИНТЕРФЕЙСА и только он: язык речи аудитора приезжает вместе с
# находкой, язык отчёта записан у проверки.
WEB_UI_LANG=

# WEB_SECRET_KEY — чем подписывается сессионная кука. Пусто — ключ делается
# на этот запуск, стенд работает, но перезапуск закрывает все открытые сессии,
# и админка говорит об этом строкой на старте. НА ПЛОЩАДКЕ ЗАДАТЬ: иначе
# каждый перезапуск выбивает всех вошедших. Короче 32 знаков не принимается —
# подобранный ключ означает поддельную куку, то есть вход без пароля.
# Взять новый: python -c 'import secrets; print(secrets.token_urlsafe(32))'
WEB_SECRET_KEY=

# WEB_TRUSTED_PROXIES — сколько СВОИХ звеньев (туннель, обратный проси) стоит
# перед сервером. Пусто — ни одного, и заголовок X-Forwarded-For не слушают
# вовсе. От этого зависит, чей адрес считает ограничитель перебора пароля
# (T325): при нуле — адрес соединения, при единице — тот, кого записал туннель.
# ЗА ТУННЕЛЕМ ЗАДАТЬ 1: иначе все приходят с одного адреса, и счётчик по адресу
# становится общим на всех. Верить заголовку по умолчанию нельзя ровно по
# обратной причине: без своего звена впереди его ставит кто угодно, то есть
# перебирающий получает бесконечный запас «адресов» одной строкой в запросе.
WEB_TRUSTED_PROXIES=

# WEB_USER_PASSWORD — пароль для НЕинтерактивного заведения учётки
# (`make web-user ARGS="add ..."` из скрипта). Обычно пусто: команда спрашивает
# пароль вводом без эха. В аргументах командной строки пароль не принимается
# вовсе — он виден в `ps` и остаётся в истории оболочки.
WEB_USER_PASSWORD=

# Снятие защиты сида демо-истории (`make web-demo`, tools/seed_web_demo.py).
# Сид пишет выдуманные проверки и потому отказывается работать, если
# DATABASE_URL ведёт не на петлю: почти всегда это площадка или база
# владельца. `1` — осознанно разрешить (свой стенд по туннелю). Пусто —
# защита включена, и это нормальное состояние.
SEED_WEB_DEMO_FORCE=

# --- Вход через учётку Google (T332, D163, D168) ---
#
# GOOGLE_CLIENT_ID — опознаватель приложения в Google. НЕ секрет: он уходит в
# адресную строку браузера при каждом входе, поэтому лежит открыто и здесь.
# Тип аудитории приложения — Internal (D168): входят только сотрудники
# организации, партнёрам вход откроется после переключения на External,
# которое Client ID и секрет сохраняет. Реквизиты боевого приложения и
# адрес стенда здесь НЕ записаны: репозиторий публичный, а пример окружения
# читают все. Они лежат у владельца, вне git.
GOOGLE_CLIENT_ID=

# GOOGLE_CLIENT_SECRET — секрет того же приложения. Пусто здесь ВСЕГДА:
# значение живёт только в окружении площадки. Google показывает его один раз
# при создании клиента; потерянный не восстанавливается, а заводится новый.
GOOGLE_CLIENT_SECRET=

# GOOGLE_REDIRECT_URI — адрес возврата, куда Google приводит человека после
# согласия. Обязан СОВПАДАТЬ побуквенно с тем, что вписано в консоли (раздел
# Clients → decimus-web → Authorized redirect URIs), иначе вход падает с
# `redirect_uri_mismatch`. Вид: `https://<адрес стенда>/audit/auth/google/callback`;
# для разработки на своей машине в консоль добавляется вторым адресом
# `http://localhost:8000/audit/auth/google/callback`.
GOOGLE_REDIRECT_URI=

# GOOGLE_MAIL_REDIRECT_URI — СВОЙ адрес возврата у согласия на почту (T352,
# D185). Отдельный от входа намеренно: Google сверяет адрес побуквенно, и по
# нему же маршрут понимает, за чем ходили — за входом или за правом положить
# черновик. В консоли он добавляется вторым в тот же список Authorized
# redirect URIs того же клиента `decimus-web` — отдельного приложения для
# почты не нужно (D174). Вид: `https://<адрес стенда>/audit/auth/google/mail` —
# с префиксом `WEB_URL_PREFIX`, как и адрес входа: наружу админка выделена
# путём, и Google сверяет адрес ровно тем, каким его видит браузер.
# Не задан — кнопки «В черновики Google» на экране письма просто нет, админка
# работает как работала.
GOOGLE_MAIL_REDIRECT_URI=
